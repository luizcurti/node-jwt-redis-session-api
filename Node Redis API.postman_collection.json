		{
			"name": "Login (happy path)",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('status is 200', () => pm.response.to.have.status(200));",
							"const body = pm.response.json();",
							"pm.test('response has message, accessToken, refreshToken and user', () => {",
							"    pm.expect(body.message).to.eql('Login successful');",
							"    pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
							"    pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
							"    pm.expect(body.user).to.include.keys('id', 'name', 'username', 'email');",
							"    pm.expect(body.user).to.not.have.property('password');",
							"});",
							"if (body.accessToken) pm.collectionVariables.set('accessToken', body.accessToken);",
							"if (body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);",
							"if (body.user && body.user.id) pm.collectionVariables.set('userId', body.user.id);"
						]
					}
				}
			],
