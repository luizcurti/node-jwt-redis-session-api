# Application
PORT=3000
# Required, at least 32 characters (RFC 7518 recommends a key as long as the
# HMAC output — 256 bits — for HS256). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace_this_with_a_random_secret_at_least_32_characters_long
# Bearer token Prometheus must send to scrape /metrics. Unset: /metrics is
# open in development and hidden (404) in production.
METRICS_TOKEN=replace_this_with_a_random_metrics_scrape_token
# Which reverse-proxy hops to trust for X-Forwarded-For: a hop count (1) or
# subnets ("loopback, 10.0.0.0/8"). `false` when clients connect directly.
# `true` is refused — it would let any client choose its own IP.
TRUST_PROXY=false

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
# Required by docker-compose.yml (no default). Generate one with:
#   openssl rand -base64 24
POSTGRES_PASSWORD=replace_this_with_a_random_postgres_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Required by docker-compose.yml (no default) — Redis runs with requirepass.
REDIS_PASSWORD=replace_this_with_a_random_redis_password
