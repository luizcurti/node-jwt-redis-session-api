{
  "name": "node-jwt-redis-session-api",
  "version": "2.0.0",
  "private": true,
  "main": "dist/server.js",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts | pino-pretty",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "migrate": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:create": "node-pg-migrate create -j sql -m migrations",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:all": "jest --runInBand",
    "test:collection": "newman run \"Node Redis API.postman_collection.json\" --env-var baseUrl=${COLLECTION_BASE_URL:-http://localhost:3000}",
    "coverage": "jest --coverage --selectProjects unit",
    "coverage:all": "jest --coverage --runInBand",
    "audit": "npm audit --omit=dev --audit-level=high",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "newman": "^6.2.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "flatted": "^3.4.4",
    "handlebars": "^4.7.9",
    "jose": "^4.15.9",
    "lodash": "^4.18.1",
    "node-forge": "^1.4.0",
    "qs": "^6.16.0",
    "underscore": "^1.13.8",
    "uuid": "^11.1.1"
  }
}
